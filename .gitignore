# --- Datasets and derived media: NEVER commit ---
# Drone-vs-Bird is distributed under a Data Usage Agreement granting no
# redistribution rights. Anti-UAV/DUT/LRDDv2 terms vary. See docs/RESEARCH.md §5.1.
# Root-anchored: a bare `datasets/` would also match src/tayr/datasets/ and silently
# exclude the package's own source from every commit.
/data/
/datasets/
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.jpg
*.jpeg
*.png
*.tif
*.tiff

# --- Model weights: use DVC/git-lfs with an external store ---
/weights/
/runs/
*.pt
*.pth
*.onnx
*.engine
*.safetensors

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# --- Node ---
node_modules/
.next/
out/

# --- OS/editor ---
.DS_Store
.idea/
.vscode/

# --- local venv ---
.venv/
.coverage
htmlcov/

# --- frontend ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# --- labelled track stores ---
# Motion features derived from footage whose licence this project does not control. The
# default store lives outside the repository; these catch an in-repo --store as well.
#
# ROOTED WITH A LEADING SLASH. A bare `tracks/` matches at any depth and silently
# excluded src/tayr/tracks/ from every commit - caught by the licence-guard job's
# "every package source file is tracked" check, which exists for exactly this.
*.jsonl
/tracks/
/demo-runs/
