# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never use `random` for any value in this file.

# --- Database ---
POSTGRES_DB=tayr
POSTGRES_USER=tayr
POSTGRES_PASSWORD=replace-me-with-a-generated-secret

# The application connects as a least-privilege role with no DDL rights.
# Migrations run as a separate, more privileged role. See docs/SECURITY.md.
DATABASE_URL=postgresql+psycopg://tayr:replace-me@localhost:5432/tayr

# --- Redis (job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Session signing ---
SECRET_KEY=replace-me-with-a-generated-secret

# --- OpenAI (incident summaries only; never sees pixels, never classifies) ---
# Server-side only. This value must never reach the frontend bundle or a client request.
OPENAI_API_KEY=
# Model id verified against the openai SDK's generated chat_model.py.
# Pricing is NOT yet verified - see docs/RESEARCH.md section 10 before setting cost caps.
OPENAI_MODEL=gpt-5-mini
OPENAI_MONTHLY_USD_CAP=10
